{
  "title": "Bridge BIM IFC delivery requirements",
  "description": "Check engineering element identity/category/material and precast schedule fields. Task dependencies, structural cases and geometry are checked separately.",
  "ifc_versions": [
    "IFC4X3_ADD2"
  ],
  "model": "bridge_bim.ifc",
  "specifications": [
    {
      "id": "B-ELEMENT",
      "name": "Engineering element classification identity and material",
      "entity": ["IFCBEAM", "IFCBEARING", "IFCSLAB", "IFCPILE", "IFCRAILING", "IFCCOLUMN", "IFCCOURSE", "IFCDISCRETEACCESSORY", "IFCWALL"],
      "material": true,
      "attributes": [
        {
          "name": "Name",
          "pattern": ".+"
        }
      ],
      "properties": [
        {
          "pset": "BridgeBIM_Element",
          "name": "ElementID",
          "pattern": ".+"
        },
        {
          "pset": "BridgeBIM_Element",
          "name": "Category",
          "pattern": ".+"
        },
        {
          "pset": "BridgeBIM_Element",
          "name": "Deck",
          "values": [
            "左幅",
            "右幅"
          ]
        }
      ]
    },
    {
      "id": "B-GIRDER",
      "name": "Precast girder schedule and structural fields",
      "entity": "IFCBEAM",
      "applicability_properties": [
        {
          "pset": "BridgeBIM_Element",
          "name": "ElementID",
          "pattern": "G-.*"
        }
      ],
      "properties": [
        {
          "pset": "BridgeBIM_Element",
          "name": "CastDate",
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        {
          "pset": "BridgeBIM_Element",
          "name": "ToStorageDate",
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        {
          "pset": "BridgeBIM_Element",
          "name": "ErectDate",
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        {
          "pset": "BridgeBIM_Structural",
          "name": "MomentFirstStageMax_kNm"
        },
        {
          "pset": "BridgeBIM_Structural",
          "name": "MomentDeadMax_kNm"
        }
      ]
    },
    {
      "id": "B-TASK",
      "name": "Formal task identification",
      "entity": "IFCTASK",
      "attributes": [
        {
          "name": "Name",
          "pattern": ".+"
        },
        {
          "name": "Identification",
          "pattern": ".+"
        }
      ]
    },
    {
      "id": "B-SCHEDULE",
      "name": "Named formal work schedule",
      "entity": "IFCWORKSCHEDULE",
      "attributes": [
        {
          "name": "Name",
          "pattern": ".+"
        }
      ]
    }
  ]
}
